# Source data (filings, news, prices).
SUPABASE_URL=
SUPABASE_KEY=

# Mailroom hosts the generated images and owns the post queue + publishing.
# The API base, prefix included (the subdomain form is https://api.mailroom.supertype.ai).
MAILROOM_API_URL=https://mailroom.supertype.ai/api/v1
MAILROOM_API_KEY=

# Caption LLMs (optional - captions fall back to templates without them).
GEMINI_API_KEY=
OPENAI_API_KEY=
